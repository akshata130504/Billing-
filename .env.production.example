# ==============================================================================
# Rooman Billing - PRODUCTION environment template
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# Consumed by docker-compose.prod.yml (env_file for db/backend/scheduler) and by
# `docker compose --env-file .env.production ...` for the ${...} interpolations.
# Every variable is read by backend/app/core/config.py unless marked "compose only".
# The API REFUSES TO START in production when: SECRET_KEY is a known default or
# shorter than 32 chars, DEBUG=true, the DB password is "postgres", DATABASE_URL is
# SQLite, ALLOWED_ORIGINS contains a localhost/127.0.0.1 origin, or SMTP_HOST is empty.
# ==============================================================================

# ---- Application ---------------------------------------------------------------
PROJECT_NAME="Rooman Billing"
# production | staging  (both enable the safety checks above)
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Public HTTPS URL of the web app. Used in emails: invitation links, password
# resets, hosted invoice / quote pages. No trailing slash.
FRONTEND_URL=https://billing.example.com

# Browser origins allowed to call the API (CORS). Comma-separated or JSON array.
# With the bundled nginx the SPA is same-origin, so this is just the public URL.
ALLOWED_ORIGINS=https://billing.example.com

# ---- Security ------------------------------------------------------------------
# REQUIRED. Signs JWT access tokens. Generate:  openssl rand -hex 32
# Rotating it logs every user out (access tokens become invalid; refresh tokens
# are stored hashed and remain valid).
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=10
# slowapi format, applied per client IP on signup/login/forgot/reset and on the
# customer-portal auth endpoints.
AUTH_RATE_LIMIT=10/minute
# Per client IP on the unauthenticated hosted pages, whose only credential is an
# opaque token in the URL: /public/invoices/*, /public/quotes/*, /checkout/public/*.
# Reads (page + PDF) use the first, state changes (accept/decline, Razorpay order and
# verify, checkout confirm) the second. Lower them if you see token enumeration.
PUBLIC_RATE_LIMIT=60/minute
PUBLIC_ACTION_RATE_LIMIT=10/minute
# Distributed rate limiting (Redis). Shared across all gunicorn/uvicorn workers.
# Internal container hostname is "redis". Leave empty to use in-memory rate limiting.
REDIS_URL=redis://redis:6379/0
# true once the site is served over HTTPS (it always should be in production).
SECURE_COOKIES=true

# ---- PostgreSQL ---------------------------------------------------------------
# The `db` service reads POSTGRES_USER/PASSWORD/DB to initialise the cluster on
# first start; the API assembles its connection string from the same values.
# POSTGRES_SERVER is forced to "db" by docker-compose.prod.yml.
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=rooman
# REQUIRED. Anything but "postgres". Generate:  openssl rand -base64 24 | tr -d '/+='
POSTGRES_PASSWORD=
POSTGRES_DB=rooman_billing
# Optional override (e.g. a managed PostgreSQL). Must use the psycopg driver.
# When set, the POSTGRES_* values above are ignored by the API (the db service
# still uses them, so remove the db service from the compose file if external).
# DATABASE_URL=postgresql+psycopg://rooman:<password>@db:5432/rooman_billing
# Per process. Keep (gunicorn workers x (POOL + OVERFLOW)) + scheduler well under
# PostgreSQL max_connections (100 by default).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

# ---- Razorpay (online payments) ---------------------------------------------------
# Leave all three empty to run with manual/offline payments only.
# Dashboard -> Account & Settings -> API Keys. Use LIVE keys in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard -> Account & Settings -> Webhooks -> URL https://<FRONTEND host>/api/v1/webhooks/razorpay
# Events: payment.captured, payment.failed, refund.processed. Paste the webhook secret here.
RAZORPAY_WEBHOOK_SECRET=

# ---- Email (SMTP) --------------------------------------------------------------
# REQUIRED in production (the API refuses to start without SMTP_HOST). Signup
# verification codes, password-reset links and team invitations are only ever delivered
# by email through this platform SMTP account - never returned in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on 587 (SMTP_USE_TLS=true) or implicit TLS on 465 (SMTP_USE_SSL=true). Not both.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=billing@example.com
EMAIL_FROM_NAME="Rooman Billing"

# ---- Background jobs -------------------------------------------------------------
# docker-compose.prod.yml overrides this per service: false on `backend`, true on
# `scheduler`. Only ONE process in the whole deployment may have it enabled.
SCHEDULER_ENABLED=false
# How often renewals, trial conversions, overdue marking and dunning run.
SCHEDULER_INTERVAL_MINUTES=15
# Overdue invoices get a reminder every N days, at most MAX times.
DUNNING_REMINDER_INTERVAL_DAYS=3
DUNNING_MAX_REMINDERS=3

# ---- AI / Roomi Assistant (Optional) -------------------------------------------
# Optional Google Gemini API key to enable generative conversational guidance.
# If omitted or unavailable, Roomi falls back gracefully to deterministic in-house
# billing knowledge and live grounded metrics.
# Get a key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Deploy poller (Optional) ---------------------------------------------------------
# Lets deploy/deploy-poll.sh keep docker-compose.prod.yml and itself in sync with the
# repo automatically, not just the built images. A fine-grained GitHub PAT scoped to
# just this one repo with "Contents: Read-only" is the safest choice; a classic PAT
# needs the `repo` scope. Leave empty to only auto-update images (no config-file sync).
GITHUB_PAT=

# ---- Observability ------------------------------------------------------------------
# One JSON object per log line (for Loki / CloudWatch / Datadog).
LOG_JSON=true
# Error tracking (optional). Empty = disabled; no Sentry code runs and the SDK is never
# imported. Project Settings -> Client Keys (DSN) in Sentry.
# PII is scrubbed before transmission (send_default_pii=false + a before_send redactor
# for Authorization headers, tokens, passwords, GSTIN/PAN and card-like fields) - see
# backend/app/core/sentry.py and docs/operations.md.
SENTRY_DSN=
# Share of requests sampled for performance tracing. Start at 0.0 (errors only);
# 0.05-0.1 is a reasonable production value once you want latency data.
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Compose only (not read by the API) --------------------------------------------------
# gunicorn worker processes for the `backend` service. Rule of thumb: 2 x vCPU, max ~8.
WEB_CONCURRENCY=2
# Tag for the locally built images.
IMAGE_TAG=latest
# Host binding for the frontend container. Default "80" publishes 0.0.0.0:80.
# With the Caddy overlay or another TLS proxy on the host use 127.0.0.1:8080.
FRONTEND_BIND=80
# Only for docker-compose.caddy.yml: public hostname and Let's Encrypt contact.
DOMAIN=billing.example.com
ACME_EMAIL=ops@example.com

# ---- Backups, alerts & deploy (compose / deploy-poll.sh only; not read by the API) -------
# IMAGE_TAG above is only a fallback for manual commands: deploy/deploy-poll.sh always
# exports IMAGE_TAG=<git sha> of the release it deploys (recorded in .deploy/deployed_sha).
#
# Failure alerts (backup job, deploy rollback, systemd poll failure) are POSTed as
# {"text": "..."} to this incoming-webhook URL (Slack / Mattermost / Teams / Discord+/slack).
ALERT_WEBHOOK_URL=
# Deploy readiness gate. Default is derived from FRONTEND_BIND, e.g.
# http://127.0.0.1:80/api/v1/health/ready. Must be reachable from the host itself.
READINESS_URL=
READINESS_TIMEOUT=180
PREDEPLOY_BACKUP_KEEP=10
#
# Nightly backup (db dump + uploads tarball) kept in the backup_data volume.
BACKUP_CRON=15 1 * * *
BACKUP_RETENTION_DAYS=30
# Offsite copy with rclone. Leave OFFSITE_BACKUP_REMOTE empty to keep backups ONLY on
# this host (not recommended). Format: offsite:<bucket>/<prefix>; the "offsite" remote
# is built from the OFFSITE_S3_* values (any S3-compatible store: AWS, B2, Wasabi, R2,
# MinIO - set OFFSITE_S3_PROVIDER / OFFSITE_S3_ENDPOINT accordingly). Use a key that can
# only write to this bucket, and enable versioning / object lock on the bucket.
OFFSITE_BACKUP_REMOTE=
OFFSITE_S3_PROVIDER=AWS
OFFSITE_S3_REGION=
OFFSITE_S3_ENDPOINT=
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Delete offsite files older than N days (empty = keep; prefer bucket lifecycle rules).
OFFSITE_RETENTION_DAYS=
# true = an offsite upload failure fails the job and alerts.
OFFSITE_REQUIRED=true
#
# Container resource limits (defaults sized for a 2 vCPU / 4 GB VM). Uncomment to override.
# BACKEND_MEM_LIMIT=1g
# BACKEND_CPUS=1.0
# SCHEDULER_MEM_LIMIT=512m
# DB_MEM_LIMIT=1g
# FRONTEND_MEM_LIMIT=256m
# REDIS_MEM_LIMIT=256m
# BACKUP_MEM_LIMIT=256m
