PROJECT_NAME="Rooman Billing"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Public URL of the frontend (used in invite / reset / hosted-page links).
FRONTEND_URL=http://localhost:5173
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-char-string-in-production
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Security / tokens (defaults shown; JWT access 30 min, rotating opaque refresh 30 days)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITE_TOKEN_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_MINUTES=60
PASSWORD_MIN_LENGTH=10
AUTH_RATE_LIMIT=10/minute
SECURE_COOKIES=false

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rooman_billing
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Optional: Override DATABASE_URL directly. If postgres is unreachable during local development without Docker,
# you can set: DATABASE_URL=sqlite:///./dev_rooman_billing.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rooman_billing

# Razorpay (leave empty for manual/offline payments only; use TEST keys locally)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email over SMTP (leave SMTP_HOST empty to disable; invite/reset links are then returned in the API response)
# For local testing run Mailpit: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit  -> SMTP_HOST=localhost SMTP_PORT=1025 SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
EMAIL_FROM_ADDRESS=billing@example.com
EMAIL_FROM_NAME="Rooman Billing"

# Background scheduler (renewals, trial conversion, overdue marking, dunning)
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MINUTES=15
DUNNING_REMINDER_INTERVAL_DAYS=3
DUNNING_MAX_REMINDERS=3

# Observability
LOG_JSON=false
