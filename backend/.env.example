PROJECT_NAME="Rooman Billing"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-char-string-in-production
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rooman_billing

# Optional: Override DATABASE_URL directly. If postgres is unreachable during local development without Docker,
# you can set: DATABASE_URL=sqlite:///./dev_rooman_billing.db
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rooman_billing
