# Line-ending policy: files executed or parsed on Linux hosts must stay LF even
# when checked out on Windows (Docker entrypoint, Makefile, nginx/Caddy configs, env files).
* text=auto
*.sh        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
Caddyfile   text eol=lf
.env*       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.png       binary
*.jpg       binary
*.ico       binary
*.pdf       binary
