# Caddy reverse proxy for Rooman Billing (used by docker-compose.caddy.yml).
# Automatic HTTPS via Let's Encrypt for {$DOMAIN}, the ONE public domain. Everything - the tenant
# app (/admin), the platform / Super Admin console (/superadmin), /api/ and the Razorpay webhook URL
# https://{$DOMAIN}/api/v1/webhooks/razorpay - goes to the frontend container, whose nginx forwards
# /api/ to the backend.

# ACME_EMAIL is required with this file: docker-compose.caddy.yml refuses to start without it and deploy/check-env.sh
# rejects a missing or placeholder value whenever DOMAIN is set (an empty `email` is invalid Caddyfile syntax).
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Outer bound only: nginx caps every request at 10 MB (CSV imports) except the platform CMS
	# media upload (/api/v1/platform/website/assets, Platform Administrators only), capped at 32 MB.
	request_body {
		max_size 33MB
	}

	reverse_proxy frontend:80 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
