# ==============================================================================
# Rooman Billing - Central Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Rooman Billing"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-char-string-in-production

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rooman_billing
# When using Docker Compose, host is 'db':
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rooman_billing

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="Rooman Billing"
