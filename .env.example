# ==============================================================================
# Rooman Billing - Central Environment Configuration Template
# Copy this file to .env and adjust variables as needed.
# ==============================================================================

# Backend Configuration
PROJECT_NAME="Rooman Billing"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-insecure-secret-key-to-a-random-32-char-string-in-production
# Public URL of the frontend (used in invite / reset / hosted-page links) and CORS allow-list.
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=rooman_billing
# Optional: override the assembled connection string. With `docker compose up`,
# the database is published on localhost:5432, so the default works as-is.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rooman_billing
# For local development without PostgreSQL you can fall back to SQLite:
# DATABASE_URL=sqlite:///./dev_rooman_billing.db
# Optional least-privilege split (docs/database-security.md): Alembic uses these owner
# credentials, the app the ones above. Unset = migrations use the runtime credentials.
# MIGRATION_POSTGRES_USER=
# MIGRATION_POSTGRES_PASSWORD=
# TLS to a remote PostgreSQL: disable|allow|prefer|require|verify-ca|verify-full
# POSTGRES_SSLMODE=

# Integrations (all optional in development; see backend/.env.example for every variable
# and .env.production.example for production guidance)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SCHEDULER_ENABLED=true
LOG_JSON=false

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_APP_TITLE="Rooman Billing"
