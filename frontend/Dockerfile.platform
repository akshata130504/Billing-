# syntax=docker/dockerfile:1.7
# Rooman platform (staff) console - web image. A separate image from the tenant web image
# (frontend/Dockerfile, unchanged): it contains only the platform bundle and proxies only
# /api/v1/platform/ to the backend. See docs/platform-console-deployment.md.
#
# Build context is frontend/:
#   docker build -f frontend/Dockerfile.platform -t rooman-billing-platform-web ./frontend

FROM node:22-alpine AS build
WORKDIR /src
# REQUIRED: origin of the TENANT app (e.g. https://billing.example.com). "Enter tenant" opens it
# and hands the grant token over by postMessage; the bundle has no production default.
#   docker build -f frontend/Dockerfile.platform \
#     --build-arg VITE_TENANT_APP_ORIGIN=https://<tenant-host> ./frontend
ARG VITE_TENANT_APP_ORIGIN
COPY docker/check-origin.sh /usr/local/bin/check-origin
RUN sh /usr/local/bin/check-origin VITE_TENANT_APP_ORIGIN "$VITE_TENANT_APP_ORIGIN" required
ENV CI=true \
    VITE_TENANT_APP_ORIGIN=${VITE_TENANT_APP_ORIGIN}
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# "build:platform" = tsc && vite build --config vite.platform.config.ts -> dist-platform/
RUN npm run build:platform

FROM nginx:1.27-alpine AS runtime
RUN rm -f /etc/nginx/conf.d/default.conf && mkdir -p /etc/nginx/snippets
COPY docker/nginx.platform.conf /etc/nginx/conf.d/default.conf
COPY docker/platform-security-headers.conf /etc/nginx/snippets/platform-security-headers.conf
COPY --from=build /src/dist-platform /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1
