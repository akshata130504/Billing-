# Empty = same origin: the dev server proxies /api to http://localhost:8000 (vite.config.ts), as nginx
# does in production, so http://localhost:5173/admin and http://localhost:5173/superadmin share one
# origin like the deployed site. Set an absolute URL only to call an API on another origin.
VITE_API_BASE_URL=
VITE_APP_TITLE="Rooman Billing"

# Support contact shown on Settings > Help (mailto link). Leave empty to disable the support forms.
VITE_SUPPORT_EMAIL=
